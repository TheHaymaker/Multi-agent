# Copy to .env (dev) or encrypt as .env.sops (prod: `sops -e .env > .env.sops`).
# Secrets are loaded into memory by app_utils/env.py and NOT injected into the process env at rest.

# --- Claude auth -------------------------------------------------------------------
# ADK orchestration glue (LiteLlm) is per-token and needs an API key:
ANTHROPIC_API_KEY=sk-ant-...
# Code Surgeon (Claude Agent SDK) can instead run on a Pro/Max SUBSCRIPTION (flat-rate):
#   1) run `claude` once and `/login` to authenticate the subscription, then
#   2) set SURGEON_USE_SUBSCRIPTION=true (default). Set false to use ANTHROPIC_API_KEY for it too.
SURGEON_USE_SUBSCRIPTION=true
REASONING_MODEL=anthropic/claude-haiku-4-5     # cheap ADK glue (classify/route/dedupe)
SURGEON_MODEL=claude-opus-4-8                   # subscription-backed code edits

# --- Forge (GitHub first; GitLab optional) -----------------------------------------
GITHUB_TOKEN=ghp_...        # least-scope bot identity: issues + PRs on agent-owned branches
# GITLAB_TOKEN=glpat-...
# GITLAB_MCP_URL=https://gitlab.com

# --- Observability sources ---------------------------------------------------------
SENTRY_AUTH_TOKEN=...
# GRAFANA_URL=http://localhost:3001
# GRAFANA_TOKEN=...

# --- Jira (optional) ---------------------------------------------------------------
# JIRA_SITE=your-team
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=...

# --- Delivery (optional) -----------------------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Behavior ----------------------------------------------------------------------
OVERNIGHT_DRY_RUN=false     # true = propose only, zero side effects (great for first runs)
POLL_MINUTES=15
DIGEST_HOUR=6

# --- Local service bindings (compose sets these for you) ---------------------------
POSTGRES_DSN=postgresql://overnight:overnight@localhost:5432/overnight
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
LANGFUSE_HOST=http://localhost:3000
